# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_AUDIENCE=your_app
JWT_ISSUER=your_company
PASSWORD_ROUNDS=10
JWT_ALGO=HS256
JWT_EXPIRES_IN=7d

# Network Configuration
NETWORK_WEBHOOK_SECRET=your_webhook_secret
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment
SUPPRESS_NO_CONFIG_WARNING=true
WEBSITE_URL=http://localhost:5000
SERVER_UI_URL=http://localhost:3001

# Testing
TEST_MODE=false
APP_TESTING_OTP=123456
APP_TESTING_MOBILE=9876543210

# Exotel Configuration
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_FROM=
EXOTEL_KEY=
EXOTEL_URL=

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Agents Configuration
AGENTS_URL=http://localhost:8000
WHATSAPP_AGENTS=http://localhost:8000/chat

# Bot Configuration
BOT_TOKEN_NETWORK=
BOT_EXPIRES_IN=30d

# WhatsApp Configuration
WHATSAPP_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=


APP_SECRET=your_meta_app_secret

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
EMAIL_SENDER_ADMIN=admin@example.com

# Default Values
DEFAULT_ORG_ID=1
DEFAULT_USER_ID=1
SLOT_DEFAULT_DURATION=30
EMAIL_TEST_MODE=true

# Redis Configuration (for Queue System)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_CLUSTER=false
REDIS_CLUSTER_NODES=

# Queue Configuration
USE_QUEUE=true

# Google OAuth (Gmail integration)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LAMBDA_ACCESS_KEY_ID=
LAMBDA_SECRET_ACCESS_KEY=
LAMBDA_BASE_URL=http://localhost:4000

# Stripe secrets encryption key (32 bytes, base64). Encrypts the per-org Stripe
# API keys stored in the configuration DB. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STRIPE_SECRETS_KEY=
