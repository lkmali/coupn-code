{
    "addLeadRequestDto": {
        "description": "Request body to add or update a lead with contact and appointment details",
        "required": true,
        "content": {
            "application/json": {
                "schema": {
                    "$ref": "#/components/schemas/AddLeadAgentDto"
                },
                "example": {
                    "name": "Rajesh Kumar",
                    "email": "rajesh.kumar@example.com",
                    "mobileNumber": "9876543210",
                    "source": "WHATSAPP",
                    "notes": "Patient inquired about dental treatment",
                    "referenceId": "shukan-9876543210",
                    "description": "Interested in teeth whitening and cleaning",
                    "followUpDate": "2025-10-25T10:00:00.000Z",
                    "gender": "MALE",
                    "age": 35,
                    "dob": "15/08/1990",
                    "userSentimentSummary": "Patient seems interested and motivated",
                    "others": "Additional patient information",
                    "aiSummary": "Patient interested in cosmetic dental procedures, seems motivated",
                    "appointmentDate": "2025-10-20T14:30:00.000Z",
                    "language": "Hindi",
                    "instagramId": "rajesh_kumar_123",
                    "messengerId": "messenger_rajesh_123",
                    "requiredFollowup": true,
                    "followupCounts": 2,
                    "isValidName": true
                }
            }
        }
    },
