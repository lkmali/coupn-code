{
    "name": "integration-backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/src/index.js",
    "workspaces": [
        "common",
        "lambda-service"
    ],
    "scripts": {
        "base64": "base64 -i firebase-service-account.json -o firebase.b64",
        "killPod": "lsof -ti :3000 | xargs kill -9",
        "docker-compose:run": "docker-compose up -d --build",
        "build:server": "rimraf dist .tsbuildinfo && tsc --skipLibCheck",
        "build:ui": "rimraf UI/out && npm --prefix UI install && npm --prefix UI run build",
        "build:all": "npm run build:ui && npm run build:server",
        "build": "npm run build:all",
        "start": "rimraf dist .tsbuildinfo && tsc && node dist/src/index.js",
        "dev": "concurrently \"node --max-old-space-size=4096 node_modules/typescript/bin/tsc --watch\" \"nodemon dist/src/index.js\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
