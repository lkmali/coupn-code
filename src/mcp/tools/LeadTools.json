                    },
                    "callId": {
                        "type": "string",
                        "description": "Unique call identifier. Either callId or sid must be provided."
                    },
                    "sid": {
                        "type": "string",
                        "description": "Session ID of the call. Either callId or sid must be provided."
                    },
                    "callStatus": {
                        "type": "string",
                        "description": "Status of the call (optional)."
                    },
                    "callSuccessful": {
                        "type": "boolean",
                        "description": "Whether the call was successful (optional)."
                    },
                    "disconnectionReason": {
                        "type": "string",
                        "description": "Reason for call disconnection (optional)."
                    },
                    "callDuration": {
                        "type": "number",
                        "description": "Duration of the call in seconds (optional).",
                        "minimum": 0
                    },
                    "description": {
                        "type": "string",
                        "description": "Description or notes about the call (optional)."
                    },
                    "action": {
                        "type": "string",
                        "description": "Action taken during or after the call (optional)."
                    },
                    "userSentiment": {
                        "type": "string",
                        "description": "Sentiment of the user during the call (optional)."
                    },
                    "circle": {
                        "type": "string",
                        "description": "Circle or region of the caller (optional)."
                    },
                    "aiSummery": {
                        "type": "string",
                        "description": "AI-generated summary of the call (optional)."
                    },
                    "recordingUrl": {
                        "type": "string",
                        "description": "URL of the call recording (optional).",
                        "format": "uri"
                    },
                    "requiredFollowup": {
                        "type": "boolean",
                        "description": "Whether follow-up is required (optional)."
                    },
                    "followupCounts": {
                        "type": "number",
                        "description": "Number of follow-ups done (optional).",
                        "minimum": 0
                    },
                    "reminderCount": {
                        "type": "number",
                        "description": "Number of reminders sent (optional).",
                        "minimum": 0
                    },
                    "followUpDate": {
                        "type": "string",
                        "description": "Next follow-up date (optional).",
                        "format": "date-time"
                    },
                    "direction": {
                        "type": "string",
                        "description": "Direction of the call (optional).",
                        "enum": [
                            "INBOUND",
                            "OUTBOUND"
                        ]
                    }
                },
                "required": [
                    "mobileNumber"
                ]
            }
        }
