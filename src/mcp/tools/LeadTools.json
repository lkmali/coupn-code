    {
        "type": "function",
        "title": "lead",
        "description": "Generate a downloadable leads report (Excel). Returns all matching leads with their details so the frontend can render a table preview and offer an Excel download.",
        "function": {
            "name": "getLeadsReport",
            "description": "Fetch leads data for a report. Returns an array of lead records with name, mobile, email, status, source, assignedToUser (resolved staff name), advertisementUrl (ad source URL), adDetails (ad name/platform/description or referral headline), notes, follow-up info, and timestamps. Rows are sorted DESC by createdAt so latest leads appear first. The frontend renders a table preview and an Excel download button. Use for 'leads report', 'export leads', 'download leads', 'leads excel', 'latest leads report', 'dropped leads report' (pass status=DROPPED), or any request to get a report/sheet of leads.",
            "parameters": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "Filter by lead status.",
                        "enum": [
                            "ALL",
                            "NEW",
                            "NOT_PICKUP",
                            "NOT_INTERESTED",
                            "FOLLOW_UP",
                            "CONVERTED",
                            "DROPPED",
                            "DEACTIVATED"
                        ]
                    },
                    "source": {
                        "type": "string",
                        "description": "Filter by lead source.",
                        "enum": [
                            "WALK_IN",
                            "CALL",
                            "WEBSITE",
                            "REFERRAL",
                            "SOCIAL_MEDIA",
                            "OTHER",
                            "WHATSAPP",
                            "INSTAGRAM",
                            "FACEBOOK",
                            "EMAIL"
                        ]
                    },
                    "startDate": {
                        "type": "string",
                        "description": "Start date for the report period (ISO 8601, e.g. '2026-04-01T00:00:00.000Z'). Filters by lead creation date."
                    },
                    "endDate": {
                        "type": "string",
                        "description": "End date for the report period (ISO 8601, e.g. '2026-04-10T23:59:59.999Z'). Filters by lead creation date."
                    },
                    "search": {
                        "type": "string",
                        "description": "Case-insensitive substring match across name, mobile, email, notes, advertisement headline/body, advertisement URL, and advertisement name/description. Use this for ad-keyword queries (e.g. '99' for ₹99 ads), ad-URL queries (e.g. 'fb.me/abc'), and notes keyword queries (e.g. 'urgent', 'callback')."
                    },
                    "assignUserId": {
                        "type": "string",
                        "description": "Filter by assigned team member's user ID."
                    },
                    "followUpDateFrom": {
                        "type": "string",
                        "description": "Filter leads whose followUpDate >= this ISO datetime. Use for 'follow-ups due today/this week' (set From=today 00:00). For 'overdue' set To=now and omit From."
                    },
                    "followUpDateTo": {
                        "type": "string",
                        "description": "Filter leads whose followUpDate <= this ISO datetime. Pair with followUpDateFrom for a range."
                    },
                    "lastActivityFrom": {
                        "type": "string",
                        "description": "Filter leads whose lastActivityAt >= this ISO datetime."
                    },
                    "lastActivityTo": {
                        "type": "string",
                        "description": "Filter leads whose lastActivityAt <= this ISO datetime. Use for 'no activity in N days' — set To=(now - N days) and omit From."
                    },
                    "hasEmail": {
                        "type": "boolean",
                        "description": "true = email present and non-empty. false = email missing/null/empty."
                    },
                    "hasMobile": {
                        "type": "boolean",
                        "description": "true = mobile present and non-empty. false = mobile missing/null/empty."
                    },
                    "hasAssignee": {
                        "type": "boolean",
                        "description": "true = lead has an assignee. false = lead is unassigned. Combine with excludeAssignUserId to express 'assigned to someone other than X'."
                    },
                    "excludeAssignUserId": {
                        "type": "string",
                        "description": "Exclude leads assigned to this user ID. Use for negation like 'leads NOT assigned to me' — resolve the name to userId first."
                    }
                },
                "required": []
            }
        }
    },
