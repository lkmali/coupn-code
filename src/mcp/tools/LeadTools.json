[
    {
        "type": "function",
        "title": "lead",
        "description": "Create a new lead with basic details. This action strictly creates a new lead and will fail if the mobile number already exists.",
        "function": {
            "name": "addNewLead",
            "description": "Create a new lead using name, mobile number, and description. Mobile number must NOT already exist.",
            "parameters": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Full name of the lead (required)."
                    },
                    "mobileNumber": {
                        "type": "string",
                        "description": "Unique mobile number (required, 10-digit or 91XXXXXXXXXX).",
                        "pattern": "^(?:91[0-9]{10}|[0-9]{10})$"
                    },
                    "source": {
                        "type": "string",
                        "description": "How the lead was acquired (optional).",
                        "enum": [
                            "WALK_IN",
                            "CALL",
                            "WEBSITE",
                            "REFERRAL",
                            "SOCIAL_MEDIA",
                            "OTHER",
                            "WHATSAPP",
                            "INSTAGRAM",
                            "FACEBOOK",
                            "EMAIL"
                        ]
                    },
                    "notes": {
                        "type": "string",
                        "description": "Why the lead contacted you / notes (required)."
                    },
                    "email": {
                        "type": "string",
                        "description": "Email of the lead (optional).",
                        "nullable": true,
                        "pattern": "^[\\w.-]+@[\\w.-]+\\.[A-Za-z]{2,}$"
                    },
                    "gender": {
                        "type": "string",
                        "description": "Gender of the lead (optional).",
                        "enum": [
                            "MALE",
                            "FEMALE",
                            "OTHERS"
                        ]
                    },
                    "age": {
                        "type": "number",
                        "description": "Age of the lead (optional).",
                        "minimum": 0,
                        "maximum": 120
                    },
                    "dob": {
                        "type": "string",
                        "description": "DOB in DD/MM/YYYY format (optional).",
                        "pattern": "^(0[1-9]|[12][0-9]|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4}$"
                    },
                    "language": {
                        "type": "string",
                        "description": "Preferred language (optional)."
                    },
                    "others": {
                        "type": "string",
                        "description": "Any additional notes (optional)."
                    },
                    "followUpDate": {
                        "type": "string",
                        "description": "When next follow-up should be done.",
                        "format": "date-time"
                    },
                    "reminderCount": {
                        "type": "number",
                        "description": "Number of reminders sent (optional).",
                        "minimum": 0
                    },
                    "isNeedSendTestimonial": {
                        "type": "boolean",
                        "description": "Whether to send testimonial to the lead (optional)."
                    },
                    "needToUpdateName": {
                        "type": "boolean",
                        "description": "Whether the lead name needs to be updated (optional)."
                    }
                },
                "required": [
                    "name",
                    "mobileNumber",
                    "source",
                    "notes"
                ]
            }
        }
    },
    {
        "type": "function",
        "title": "lead",
        "description": "Fetch a list of leads with filters such as search, status, date range, or pagination.",
        "function": {
            "name": "getLeadList",
            "description": "Retrieve multiple leads with filtering and pagination support. Supports filtering by lead creation date via startDate/endDate (applied to createdAt).",
            "parameters": {
                "type": "object",
                "properties": {
                    "skip": {
                        "type": "number",
                        "minimum": 0
                    },
                    "limit": {
                        "type": "number",
                        "minimum": 1
                    },
                    "orderBy": {
                        "type": "string",
                        "enum": [
                            "ASC",
                            "DESC"
                        ]
                    },
                    "sortBy": {
                        "type": "string"
                    },
                    "search": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ALL",
                            "NEW",
                            "NOT_PICKUP",
                            "NOT_INTERESTED",
                            "FOLLOW_UP",
                            "CONVERTED",
                            "DROPPED",
                            "DEACTIVATED"
                        ]
                    },
                    "source": {
                        "type": "string",
                        "enum": [
                            "ALL", "WALK_IN", "WALK_IN_OPD", "WALK_IN_CAMP",
                            "CALL", "WEBSITE", "REFERRAL", "SOCIAL_MEDIA", "OTHER",
                            "INSTAGRAM", "WHATSAPP", "MESSENGER", "FACEBOOK", "EMAIL"
                        ],
                        "description": "Lead source. Must be UPPER_SNAKE_CASE exactly as listed."
                    },
                    "startDate": {
                        "type": "string",
                        "description": "Start of createdAt range (ISO 8601, e.g. '2026-05-21T00:00:00.000Z'). Use for arbitrary date ranges like 'leads added this week' or 'today'."
                    },
                    "endDate": {
                        "type": "string",
                        "description": "End of createdAt range (ISO 8601, e.g. '2026-05-21T23:59:59.999Z')."
                    }
                },
                "required": []
            }
        }
    },
    {
        "type": "function",
        "title": "lead",
        "description": "Open the edit-lead form for a lead. Use when the user wants to edit, update, modify, or change a lead's details. Call with no arguments if the user has not provided an identifier yet — this returns a card asking for a phone or lead number. Call with `identifier` when the user provides a phone number or lead number — this looks up the lead and returns its full details for the edit form.",
        "function": {
            "name": "editLead",
            "description": "Begin an edit-lead flow. Returns a prompt card when no identifier is given; otherwise looks up the lead and returns the edit form (or a selection list if multiple match).",
            "parameters": {
                "type": "object",
                "properties": {
                    "identifier": {
                        "type": "string",
                        "description": "Phone number (e.g. '919824501520') or lead number (e.g. '217'). Omit this parameter to prompt the user for one."
                    },
                    "searchBy": {
                        "type": "string",
                        "description": "Which field to look the identifier up by. The frontend lets the user pick one of these explicitly when starting an edit-lead flow. If omitted, a heuristic is used.",
                        "enum": [
                            "mobileNumber",
                            "leadNumber"
                        ]
                    }
                },
                "required": []
            }
        }
    },
